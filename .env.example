# ===============================================================
# 🔐 متغيرات البيئة المطلوبة لتشغيل النظام (Environment Variables)
# انسخ هذه المتغيرات وضعها في ملف .env محلياً أو في لوحة تحكم الاستضافة
# ===============================================================

# 1. قاعدة البيانات Supabase (من Settings -> API في Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# 2. مفتاح Gemini الذكاء الاصطناعي (من Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key

# 3. توكن بوت تليجرام الرئيسي (من BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 4. معرف التليجرام الخاص بك كسوبر أدمن (احصل عليه عبر إرسال /start لبوت @userinfobot)
SUPER_ADMIN_CHAT_ID=123456789

# 5. التحقق من Webhook الخاص بشركة Meta (فيسبوك، إنستجرام، واتساب)
META_VERIFY_TOKEN=غيّر_دي_لقيمة_عشوائية
META_APP_SECRET=your_meta_app_secret_from_developers_facebook

# 6. التحقق من Webhook الخاص بـ TikTok (اختياري لو بتستخدم تيك توك)
TIKTOK_APP_SECRET=your_tiktok_app_secret

# 7. سقف الرسائل اليومية التلقائية لكل تاجر (افتراضي: 1000)
TENANT_DAILY_MESSAGE_CAP=1000

# 8. وضع التطوير المحلي (اختياري: اضبطه على 1 للسماح بالـ webhooks غير الموقعة محلياً فقط)
# ALLOW_UNSIGNED_WEBHOOKS=1
